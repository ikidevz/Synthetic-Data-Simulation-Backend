# --- Authentication -------------------------------------------------------
# Every route except /health requires an X-API-Key header once a key is set.
# Generate a strong key with:   python -m app.cli genkey
# Sample below shows the expected format/length only — it's public in this
# file, so don't use it for anything real; generate your own.
# API_KEY=yAyVcBerESQMFIV7YHiEABgHtqzYn5zlWnXEgfEpMAY

# Rotate keys without downtime: list several (comma-separated), move clients
# over, then remove the old one. Read together with API_KEY.
# API_KEYS=new-key,old-key

# Refuse to start without a key. Turn this on for any deployment.
# REQUIRE_API_KEY=true

# Hide /docs, /redoc and /openapi.json.
# ENABLE_DOCS=false

# --- Database ---------------------------------------------------------------
# Defaults to a local SQLite file. docker-compose.yml sets this for Postgres.
# DATABASE_URL=postgresql+psycopg2://synthetic:synthetic@localhost:5432/synthetic
