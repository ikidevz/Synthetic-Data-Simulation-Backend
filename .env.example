# --- Authentication -------------------------------------------------------
# API_KEY / API_KEYS are the SUPERUSER keys: they can read and write everything and
# create providers. Providers get their own keys from POST /v1/admin/providers.
# Every route except /health requires an X-API-Key header once a key is set.
# Generate a strong key with:   python -m app.cli genkey
# Sample below shows the expected format/length only — it's public in this
# file, so don't use it for anything real; generate your own.
API_KEY=yAyVcBerESQMFIV7YHiEABgHtqzYn5zlWnXEgfEpMAY

# Rotate keys without downtime: list several (comma-separated), move clients
# over, then remove the old one. Read together with API_KEY.
# API_KEYS=new-key,old-key

# Refuse to start without a key. Turn this on for any deployment.
# REQUIRE_API_KEY=true

# Hide /docs, /redoc and /openapi.json.
# ENABLE_DOCS=false

# --- Database ---------------------------------------------------------------
# Defaults to a local SQLite file. docker-compose.yml sets this for Postgres.
# DATABASE_URL=postgresql+psycopg2://synthetic:synthetic@localhost:5432/synthetic

# --- Provider quotas (projects and configs published through /v1) -----------
# Each is optional; the values shown are the defaults. A malformed value stops start-up.
# MAX_PROJECTS_PER_PROVIDER=3     projects (schemas) one provider can hold
# MAX_CONFIGS_PER_PROJECT=10      configs (tables) in one project
# MAX_CONFIGS_PER_PROVIDER=10     configs across ALL of a provider's projects (the storage ceiling)
# MAX_FIELDS_PER_CONFIG=40        fields per config
# MAX_INITIAL_COUNT=10000         seed.initial_count
# MAX_ROWS_PER_CONFIG=50000       total rows per config (batch, simulate and the scheduler stop here)
# MAX_LATENCY_MS=5000             failure_injection.latency_ms
# MAX_CONFIG_BYTES=65536          size of a config body
